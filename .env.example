NODE_ENV=development
PORT=3000
APP_NAME=mykwatta
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Infra: pnpm run dev:up → docker-compose.dev.yml (no Redis service — reuse shared Redis)
# Host publish ports (change if 5432/9000/… are taken on the server):
POSTGRES_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Host (API outside Docker): localhost + ports above. Inside compose: postgres / rustfs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mykwatta
# Shared Redis (other Dokploy project). Use that service hostname on the same Docker network.
REDIS_URL=redis://<other-project-redis-hostname>:6379

# API boot: migrate always (MIGRATE_ON_BOOT=false to skip).
# NODE_ENV=development: also seed if empty. SEED_ON_BOOT=true → wipe+seed every boot.
# MIGRATE_ON_BOOT=true
SEED_ON_BOOT=false

BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Fixed OTP when NODE_ENV=development|test (ignored in staging/production)
AUTH_DEV_OTP=000000

# console = log OTP locally | live = Twilio APIs
TWILIO_MODE=console
TWILIO_OTP_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# CONSOLE | SENDGRID | RESEND
MAIL_PROVIDER=CONSOLE
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MYKWATTA
SENDGRID_API_KEY=
RESEND_API_KEY=

# CONSOLE | RUSTFS (S3-compatible — primary object store)
# App buckets are code constants (StorageBucket): mykwatta-listings, mykwatta-kyc
STORAGE_PROVIDER=RUSTFS
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mykwatta
S3_SECRET_KEY=mykwatta-secret-change-me
S3_REGION=us-east-1

# CONSOLE | LIVE — LIVE routes XAF/MOBILE_MONEY→Fapshi, CARD→Stripe
# Docs: https://docs.fapshi.com/en
PAYMENTS_MODE=CONSOLE
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CONSOLE | LIVE — LIVE emits to Pusher Channels (private-user-{userId})
# FE: GET /api/notifications/realtime + authEndpoint POST /api/notifications/pusher/auth
PUSHER_MODE=CONSOLE
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# CONSOLE | LIVE — LIVE sends FCM (Android) + APNs (iOS)
# Register devices: POST /api/notifications/devices { platform: FCM|APNS, token }
PUSH_MODE=CONSOLE
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false
